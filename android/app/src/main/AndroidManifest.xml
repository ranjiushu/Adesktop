<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 全盘访问（「授权访问手机存储」主模式，内部使用）：
         Android 11+ = MANAGE_EXTERNAL_STORAGE（用户到系统设置页手动开启，见 MainActivity）；
         Android 10 及以下 = WRITE_EXTERNAL_STORAGE 运行时权限 + requestLegacyExternalStorage
         （Android 11+ 忽略 legacy 标志，由 MANAGE_EXTERNAL_STORAGE 接管） -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Android 11+ 包可见性：允许查询所有 launcher 应用（「已安装应用」工具）。
         比 QUERY_ALL_PACKAGES 更受限，符合 launcher 型应用推荐做法。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Adesktop"
        android:usesCleartextTraffic="true">

        <activity
            android:name="com.ranjiushu.adesktop.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
