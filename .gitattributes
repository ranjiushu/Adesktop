# 行尾统一：文本文件 LF 入库。CRLF 会破坏 bash 脚本/构建链，
# 并使 git 在跨环境(尤其 Windows)迁移时产生大量假 diff。
# 规则对齐 lexicull/.gitattributes。

* text=auto

*.sh         text eol=lf
*.js         text eol=lf
*.ts         text eol=lf
*.mjs        text eol=lf
*.cjs        text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.java       text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.xml        text eol=lf
*.gradle     text eol=lf
*.properties text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.txt        text eol=lf
*.pro        text eol=lf
*.proguard   text eol=lf
.gitignore   text eol=lf
gradlew      text eol=lf
githooks/*   text eol=lf

*.bat        text eol=crlf

# 二进制
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.apk      binary
*.enc      binary
*.zip      binary
*.jar      binary
*.keystore binary
