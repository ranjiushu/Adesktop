#!/usr/bin/env bash
# 防线 0: 废弃分支（墓地）拦截
# 防线 1: main 稳定分支保护（只接受 merge commit）
# 防线 2: src/ 与构建产物一致性校验（src 比 dist 新则拦截）
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# ── 防线 0: 分支墓地检查 ──
_branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
_graveyard="$(git rev-parse --git-dir)/branch-graveyard"
if [ -n "$_branch" ] && [ -f "$_graveyard" ] && grep -qxF "$_branch" "$_graveyard"; then
  echo "[pre-commit] 分支 '$_branch' 已废弃，禁止在其上提交" >&2
  echo "[pre-commit] 请切换到 feat/dev，或从主线新建 feat/|fix/|exp/ 分支" >&2
  exit 1
fi

# ── 防线 1: main 保护 ──
if [ "$_branch" = "main" ]; then
  # 无 HEAD（新仓库首个提交）允许：main 需要初始基线
  if git rev-parse -q --verify HEAD >/dev/null 2>&1 && ! git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    echo "[pre-commit] main 是稳定发布分支，禁止直接提交" >&2
    echo "[pre-commit] 请在 feat/dev 上开发，稳定后 merge --no-ff 合入" >&2
    exit 1
  fi
fi

# ── 防线 2: src/ 与 dist/ 一致性 ──
# 仅当本次改动涉及 src/ 或 dist/ 时检查；无构建脚本则跳过
if command -v node &>/dev/null && [ -f tools/build-web.sh ] && git diff --cached --name-only | grep -qE '^(src/|dist/)'; then
  if ! bash tools/build-web.sh --check > /dev/null 2>&1; then
    echo "[pre-commit] src/ 与 dist/adesktop.bundle.html 不一致——请先运行 bash tools/build-web.sh" >&2
    exit 1
  fi
fi

# >>> repo-resume: entry-doc-governance (start) >>>
# 由 repo-resume 技能（子技能 entry-doc-governance）的 install-hook.sh 写入，**勿手改**；
# 更新走上游重跑安装脚本（幂等）。守卫本体：tools/guards/guard.py
{
  _gd_root="$(git rev-parse --show-toplevel 2>/dev/null)"
  _gd_guard="$_gd_root/tools/guards/guard.py"
  if [ -z "$_gd_root" ] || [ ! -f "$_gd_guard" ]; then
    echo "[pre-commit] ❌ 文档守卫缺失（tools/guards/guard.py）—— fail-closed，拒绝提交" >&2
    echo "[pre-commit]    修复：重跑上游 install-hook.sh（幂等；上游位置见 tools/guards/SOURCE.md）" >&2
    exit 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "[pre-commit] ❌ 缺 python3，无法校验 AGENTS.md 信息密度 —— fail-closed，拒绝提交" >&2
    exit 1
  fi
  ( cd "$_gd_root" && PYTHONDONTWRITEBYTECODE=1 python3 "$_gd_guard" --staged )
  _gd_rc=$?
  if [ "$_gd_rc" -eq 1 ]; then exit 1; fi
  if [ "$_gd_rc" -ne 0 ] && [ "$_gd_rc" -ne 2 ]; then
    echo "[pre-commit] ❌ 文档守卫异常退出（rc=$_gd_rc）—— fail-closed，拒绝提交" >&2
    exit 1
  fi
}
# <<< repo-resume: entry-doc-governance (end) <<<
exit 0
